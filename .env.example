# ---- Google Cloud / Vertex AI ----
# Your GCP project id. Required.
GOOGLE_CLOUD_PROJECT=my-project-id

# Vertex region. Pick one close to you that serves the model.
# asia-east2 (Hong Kong) / asia-southeast1 (Singapore) / us-central1 / europe-west2 (London)
GOOGLE_CLOUD_LOCATION=asia-southeast1

# Auth: run `gcloud auth application-default login` for local dev.
# On Cloud Run the attached service account is used automatically.
# Only set this if you are using a downloaded key file instead:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# ---- Models ----
# Gemini 3.5 Pro is not released yet (checked Aug 2026). 3.6 Flash is GA on
# Vertex, is natively multimodal, and does transcription + diarization.
# Swap these the day a better model ships -- nothing else needs to change.
MODEL_LIVE=gemini-3.6-flash
MODEL_TRANSCRIBE=gemini-3.6-flash
MODEL_MINUTES=gemini-3.6-flash

# ---- Long meetings ----
# Optional. If set, the full recording is uploaded here and transcribed in a
# single pass, which keeps speaker labels consistent across the whole meeting.
# Without it, meetings longer than ~8 minutes are transcribed in segments and
# stitched together (works fine, marginally more speaker-label drift).
# GCS_BUCKET=my-minutes-audio-bucket

# ---- Local ----
PORT=8080
DATA_DIR=./data

# Comma-separated origins allowed to hit the API. Leave unset in production
# (the server serves the web app itself, so same-origin).
# CORS_ORIGINS=http://localhost:5173
