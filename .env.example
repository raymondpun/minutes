# ---- Google Cloud / Vertex AI ----
# Your GCP project id. Required.
GOOGLE_CLOUD_PROJECT=my-project-id

# Vertex region. Pick one close to you that serves the model.
# asia-east2 (Hong Kong) / asia-southeast1 (Singapore) / us-central1 / europe-west2 (London)
GOOGLE_CLOUD_LOCATION=asia-southeast1

# Auth: run `gcloud auth application-default login` for local dev.
# On Cloud Run the attached service account is used automatically.
# Only set this if you are using a downloaded key file instead:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# ---- Models ----
# Gemini 3.5 Pro is not released yet (checked Aug 2026). 3.6 Flash is GA on
# Vertex, is natively multimodal, and does transcription + diarization.
# Swap these the day a better model ships -- nothing else needs to change.
MODEL_LIVE=gemini-3.6-flash
MODEL_TRANSCRIBE=gemini-3.6-flash
MODEL_MINUTES=gemini-3.6-flash

# ---- Live transcript ----
# The live transcript is not just a mic check -- it is scrollback. At 01:30 you
# want to be able to look at what was said at 00:30, so it runs for the whole
# meeting and is searchable on screen.
#
# It is also most of the AI bill, because every chunk re-sends the same language
# rules. So the batch size ramps: short chunks while you are still checking the
# mic hears everyone, longer once the meeting is underway. A 2 hour meeting goes
# from 360 model calls to 126, with no loss of coverage.
LIVE_INITIAL_CHUNK_SECONDS=20
LIVE_STEADY_CHUNK_SECONDS=60
LIVE_RAMP_AFTER_SECONDS=180

# Bigger lever, with a real trade-off: run the live pass on a cheaper model.
# Flash-Lite is roughly 5x cheaper on input and takes the live pass on a 2 hour
# meeting from ~$0.66 to ~$0.16. The authoritative transcript still uses
# MODEL_TRANSCRIBE on the full recording, so the risk is confined to how
# readable the on-screen scrollback is -- which matters more if you actually
# read it back. Try it on a real meeting before committing.
# MODEL_LIVE=gemini-3.5-flash-lite

# ---- Keeping the recording ----
# Every claim in the minutes carries a timestamp and a verbatim quote, so
# keeping the audio turns that from "trust the translation" into a play button
# next to each quote.
#
# 0        delete as soon as the minutes are drafted
# <number> keep for that many days, then the bucket deletes it
# forever  keep indefinitely; deploy.sh tiers it Nearline -> Coldline -> Archive
#
# Storage is not the constraint: 16 kHz mono is ~115 MB an hour, so a hundred
# two-hour meetings is roughly US$0.50/month in Standard and pennies once tiered.
# The reason to bound it is that these are recordings of colleagues' voices.
# Whatever you set, the consent announcement on the pre-flight screen says it.
RETAIN_AUDIO_DAYS=30

# ---- Long meetings ----
# Optional. If set, the full recording is uploaded here and transcribed in a
# single pass, which keeps speaker labels consistent across the whole meeting.
# Without it, meetings longer than ~8 minutes are transcribed in segments and
# stitched together (works fine, marginally more speaker-label drift).
# GCS_BUCKET=my-minutes-audio-bucket

# ---- Local ----
PORT=8080
DATA_DIR=./data

# Comma-separated origins allowed to hit the API. Leave unset in production
# (the server serves the web app itself, so same-origin).
# CORS_ORIGINS=http://localhost:5173
